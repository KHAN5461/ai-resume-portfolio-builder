rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      // IMPORTANT: Prevent users from writing the 'isPremium' field
      allow write: if request.auth != null && request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'plan', 'stripeCustomerId', 'stripeSubscriptionId']));
    }
  }
}
