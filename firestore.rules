rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // User Data collection
    match /user_data/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Resumes collection
    match /resumes/{resumeId} {
      allow read: if true; // Public view links and client queries
      allow write: if true;
    }

    // Portfolios collection
    match /portfolios/{portfolioId} {
      allow read: if true; // Public web portfolios and studio queries
      allow write: if true;
    }

    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
